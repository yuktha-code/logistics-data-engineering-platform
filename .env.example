# Local development credentials only. Do NOT reuse for cloud deployment.
POSTGRES_USER=logistics_dev
POSTGRES_PASSWORD=logistics_dev_change_me
POSTGRES_DB=logistics
WAREHOUSE_URL=postgresql+psycopg2://logistics_dev:logistics_dev_change_me@localhost:5433/logistics
# Advanced optional local development mode (never expose unauthenticated Mongo publicly)
MONGO_URI=mongodb://localhost:27018
# Requires Python 3.11, PySpark, Java 17, running MongoDB for full pipeline

# Optional cloud archive. Do not commit real credentials or tokens.
ENABLE_AZURE_ARCHIVE=0
AZURE_BLOB_CONTAINER=logistics-archive
AZURE_BLOB_PREFIX=logistics/events/v1
# For host-only Azurite emulator test: UseDevelopmentStorage=true
# AZURE_STORAGE_CONNECTION_STRING=
# For real Azure: Azure account URL plus DefaultAzureCredential (az login)
# AZURE_STORAGE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
